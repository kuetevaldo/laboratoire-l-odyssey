DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production private object storage (Neon Object Storage, Cloudflare R2, or S3)
S3_ENDPOINT=
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=odyssey-private

# One-time administrator seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Administrateur

# One-time migration from the existing XAMPP database
MYSQL_DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:3306/borel_clinique
LEGACY_PROJECT_DIR=..
